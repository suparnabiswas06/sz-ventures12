{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {"source": "/(.*)","headers": [
      {"key":"X-Content-Type-Options","value":"nosniff"},
      {"key":"X-Frame-Options","value":"SAMEORIGIN"},
      {"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},
      {"key":"Permissions-Policy","value":"camera=(), microphone=(), geolocation=()"}
    ]}
  ],
  "redirects":[
    {"source":"/home","destination":"/","permanent":true},
    {"source":"/index","destination":"/","permanent":true}
  ],
  "rewrites":[
    {"source":"/portfolio","destination":"/portfolio.html"},
    {"source":"/philosophy","destination":"/philosophy.html"},
    {"source":"/achievements","destination":"/achievements.html"},
    {"source":"/careers","destination":"/careers.html"},
    {"source":"/contact","destination":"/contact.html"},
    {"source":"/insights","destination":"/insights.html"},
    {"source":"/press","destination":"/press.html"},
    {"source":"/privacy","destination":"/privacy.html"},
    {"source":"/cookies","destination":"/cookies.html"}
  ]
}